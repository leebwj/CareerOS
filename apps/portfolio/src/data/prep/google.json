  "formatIntel": {
    "summary": "The opposite of Palantir: a conventional DS&A loop, where the variance is in how you communicate rather than what you're asked. Google scores on four named axes — General Cognitive Ability, Role-Related Knowledge, Leadership, and 'Googleyness' — and interviewers file independent written feedback against them, so each round is judged on its own. For interns and new grads an offer is usually conditional on host/team matching after the loop passes.",
    "rounds": [
      {
        "name": "Resume screen",
        "length": "—",
        "tests": "Fit against the req; internships are volume-filtered",
        "scoring": "Signal density — shipped work and measurable outcomes over coursework",
        "prep": "Apply early in the cycle. Intern reqs fill and close well before the posted deadline."
      },
      {
        "name": "Online assessment",
        "length": "~90 min",
        "tests": "Two DS&A problems, auto-graded. Not always issued",
        "scoring": "Correctness against hidden tests — no partial credit for approach here",
        "prep": "The one round where only the passing test matters, so optimise for a correct brute force before a clever one."
      },
      {
        "name": "Technical phone screen",
        "length": "45 min, Meet + shared doc",
        "tests": "One to two DS&A problems, typed in a doc with no autocomplete and no execution",
        "scoring": "Approach and complexity stated BEFORE coding; clean code without a compiler to lean on",
        "prep": "Practice in a plain doc, not an IDE. Say the complexity out loud before you start typing."
      },
      {
        "name": "Virtual onsite — coding",
        "length": "2–3 × 45 min, same day",
        "tests": "DS&A: arrays/strings, hash maps, trees and graphs, dynamic programming, heaps",
        "scoring": "General Cognitive Ability and Role-Related Knowledge. Silence scores badly even when the code is right",
        "prep": "Narrate continuously. Clarify inputs, state the approach, then code, then walk through a real example."
      },
      {
        "name": "Googleyness & Leadership",
        "length": "45 min",
        "tests": "Behavioral: ambiguity, collaboration, conflict, bias to action",
        "scoring": "The Leadership and Googleyness axes — comfort with ambiguity and working without authority",
        "prep": "Four or five STAR stories that flex. More common for new grad than intern, but do not be caught without them."
      },
      {
        "name": "Host matching",
        "length": "Varies — days to weeks",
        "tests": "Fit conversations with teams that have headcount",
        "scoring": "Not a rejection gate so much as an availability one — mutual interest with a specific host",
        "prep": "Have a short, specific answer on the kind of work you want. Vagueness stalls matching."
      }
    ]
  },
