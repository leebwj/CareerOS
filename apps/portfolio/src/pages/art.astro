---
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/art.json";

// Read real pixel dimensions at build time (zero-dep: PNG IHDR / JPEG SOF).
// Two payoffs: every <img> ships width+height so a 46-plate set scrolls with
// ZERO layout shift, and the true aspect drives the reader's layout rhythm
// (wide plates run full width, uprights pair two-up) instead of one flat stack.
function imgInfo(src: string) {
  try {
    const b = fs.readFileSync(path.join("public", src));
    const id = crypto.createHash("md5").update(b).digest("hex");   // same read → free dedupe key
    let d: { w: number; h: number } | null = null;
    if (b[0] === 0x89 && b[1] === 0x50) d = { w: b.readUInt32BE(16), h: b.readUInt32BE(20) };
    else if (b[0] === 0xff && b[1] === 0xd8) {
      let o = 2;
      while (o < b.length - 9) {
        if (b[o] !== 0xff) { o++; continue; }
        const m = b[o + 1];
        if (m >= 0xc0 && m <= 0xcf && m !== 0xc4 && m !== 0xc8 && m !== 0xcc) { d = { h: b.readUInt16BE(o + 5), w: b.readUInt16BE(o + 7) }; break; }
        o += 2 + b.readUInt16BE(o + 2);
      }
    }
    return { id, ...(d || { w: 0, h: 0 }) };
  } catch { /* missing/unreadable file → no dimensions, no dedupe key */ }
  return null;
}
const sized = projects.map((p) => {
  // dedupe by CONTENT, not filename: the original Cargo scrape saved a few
  // plates twice under different names (odds-and-ends 01 == 02 == 10), which
  // showed the same drawing three times in the set
  const seen = new Set<string>();
  const plates = (p.images || []).flatMap((src) => {
    const d = imgInfo(src);
    if (d?.id) { if (seen.has(d.id)) return []; seen.add(d.id); }
    return [{ src, w: d?.w || 0, h: d?.h || 0, wide: d && d.h ? d.w / d.h >= 1.15 : true }];
  });
  // Remote YouTube thumbnails can't be measured off disk, but hqdefault is
  // always 480x360 — without this the card has no intrinsic size, so it starts
  // at height 0, reflows the masonry on load, and the cursor can't snap to it.
  const cover = p.cover || null;
  const coverSize = !cover ? null
    : /^https?:\/\/i\.ytimg\.com\//.test(cover) ? { w: 480, h: 360 }
    : imgInfo(cover);
  return { ...p, plates, coverSize };
});
// ── sandbox placement, computed at build ─────────────────────────────────────
// Deterministic (seeded) so the board is identical every build and reload.
// Free scatter + collision relaxation (see below). Collisions are only resolved
// where pieces actually overlap — spacing is never equalised — so the natural
// clustering of the random seed survives and the wall looks hung, not laid out.
const rnd = (n: number, salt: number) => {
  const x = Math.sin(n * 127.1 + salt * 311.7) * 43758.5453;
  return x - Math.floor(x);
};
// Board is deliberately tight: a roomier board scatters beautifully but you land
// on a void, which is the trap the first sandbox build hit. Denser packing keeps
// several pieces in the first screen either side of the title.
const BOARD_W = 2960, BOARD_H = 1880;
const CARD_W = 330;                                  // cards' max CSS width
const TITLE = { x: BOARD_W / 2 - 340, y: BOARD_H / 2 - 190, w: 680, h: 380 };

// Pieces are scattered freely and then RELAXED apart, rather than jittered
// inside grid cells. The old jittered grid only had ~50px of horizontal play in
// a 430px cell, so columns and rows still read through it and the board looked
// laid out rather than hung. Free placement + push-apart keeps the organic look
// while still guaranteeing no piece can cover another.
type Piece = { i: number; w: number; h: number; hBox: number; cx: number; cy: number; sc: number; sr: number };
const pieces: Piece[] = sized.map((p, i) => {
  const sc = 0.78 + rnd(i, 3) * 0.42;                        // 0.78–1.20
  const ratio = p.coverSize && p.coverSize.w ? p.coverSize.h / p.coverSize.w : 0.72;
  // The card renders at exactly width x ratio (img is width:100%, height auto).
  // Clamping this to 430 underestimated tall portrait scans (ratio ~1.41 renders
  // 466px), and every underestimate becomes a real overlap on the board.
  const h0 = CARD_W * ratio * sc;
  const w0 = CARD_W * sc;
  const sr = rnd(i, 4) * 16 - 8;                             // −8°…+8°, clearly hand-hung
  // A tilted card occupies MORE room than its box: collide on the rotated
  // footprint, or neighbours that look 16px apart will clip corners once tilted.
  const t = Math.abs(sr) * Math.PI / 180, c = Math.cos(t), s = Math.sin(t);
  return {
    i, sc, sr, h: h0,
    w: w0 * c + h0 * s,
    hBox: w0 * s + h0 * c,
    cx: 120 + rnd(i, 1) * (BOARD_W - 240),
    cy: 110 + rnd(i, 2) * (BOARD_H - 220),
  } as Piece;
});

const PAD = 16;                                              // breathing room between pieces
const overlapPush = (a: Piece, b: Piece) => {
  const dx = b.cx - a.cx, dy = b.cy - a.cy;
  const minX = (a.w + b.w) / 2 + PAD, minY = (a.hBox + b.hBox) / 2 + PAD;
  const ox = minX - Math.abs(dx), oy = minY - Math.abs(dy);
  if (ox <= 0 || oy <= 0) return;                             // not overlapping
  // separate along the shallower axis — cheapest way out of the collision
  if (ox < oy) { const s = (dx < 0 ? -1 : 1) * ox * 0.5; a.cx -= s; b.cx += s; }
  else { const s = (dy < 0 ? -1 : 1) * oy * 0.5; a.cy -= s; b.cy += s; }
};
const collisions = () => {
  let n = 0;
  for (let a = 0; a < pieces.length; a++) for (let b = a + 1; b < pieces.length; b++) {
    const A = pieces[a], B = pieces[b];
    if (Math.abs(B.cx - A.cx) < (A.w + B.w) / 2 && Math.abs(B.cy - A.cy) < (A.hBox + B.hBox) / 2) n++;
  }
  return n;
};
// Relax, then VERIFY. Clamping pieces to the board edge fights separation, so a
// board that is slightly too tight can never settle — it just trades one overlap
// for another. Rather than hand-tuning the size until it happens to work, grow
// the board a little and retry until the layout is provably clean.
let boardW = BOARD_W, boardH = BOARD_H;
for (let attempt = 0; attempt < 14; attempt++) {
  for (let pass = 0; pass < 220; pass++) {
    for (let a = 0; a < pieces.length; a++) {
      for (let b = a + 1; b < pieces.length; b++) overlapPush(pieces[a], pieces[b]);
    }
    for (const p of pieces) {
      // keep the centre clear for the title block
      const tOx = (TITLE.w + p.w) / 2 + PAD - Math.abs(p.cx - boardW / 2);
      const tOy = (TITLE.h + p.hBox) / 2 + PAD - Math.abs(p.cy - boardH / 2);
      if (tOx > 0 && tOy > 0) {
        if (tOx < tOy) p.cx += (p.cx < boardW / 2 ? -1 : 1) * tOx;
        else p.cy += (p.cy < boardH / 2 ? -1 : 1) * tOy;
      }
      p.cx = Math.min(Math.max(p.cx, p.w / 2 + 30), boardW - p.w / 2 - 30);
      p.cy = Math.min(Math.max(p.cy, p.hBox / 2 + 30), boardH - p.hBox / 2 - 30);
    }
  }
  if (collisions() === 0) break;
  boardW = Math.round(boardW * 1.05);
  boardH = Math.round(boardH * 1.05);
}

const withCover = sized.map((p, i) => {
  const q = pieces[i];
  return {
    ...p,
    count: p.images.length + p.youtube.length + (p.video ? 1 : 0) + (p.videoPending ? 1 : 0),
    // grid cards paint at ~300px — they load a 720px webp thumb, not the full plate
    thumb: p.cover && !/^https?:/.test(p.cover) ? `/art/_thumbs/${p.slug}.webp` : p.cover,
    // left/top of the unscaled box; scale+rotate happen about the card's centre
    sx: Math.round(q.cx - CARD_W / 2),
    sy: Math.round(q.cy - q.h / q.sc / 2),
    sc: q.sc.toFixed(2),
    sr: q.sr.toFixed(1),
  };
});
---

<BaseLayout
  title="Art — Brian Wonjun Lee"
  description="Selected art by Brian Lee — 3D renders, light installations, spatial compositions, drawings, and studies."
>
  <main class="art">
    <header class="art-top">
      <a href="/" class="art-back" data-cursor="home">← Brian Lee</a>
      <div class="art-top-r">
        <span class="art-yr">Studio · Selected Works</span>
        <button id="mode-toggle" class="art-mode" aria-label="Toggle light / dark" data-cursor="light / dark">
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <!-- THE SANDBOX: the gallery is a drafting table larger than the window.
         Drag the board to move around; drag a piece to re-hang it; click/tap a
         piece to open it. The title lives at the centre of the board. -->
    <div class="ag-stage" id="ag-stage" data-lenis-prevent tabindex="0" aria-label="Art board — drag to explore, arrow keys to pan" style={`--board-w:${boardW}px; --board-h:${boardH}px`}>
      <section class="ag-grid" id="ag-grid" style={`width:${boardW}px; height:${boardH}px`}>
        <div class="ag-center reveal" aria-hidden="false">
          <h1 class="art-title">Art</h1>
          <p class="art-lede">
            A quieter room — 3D renders, light installations, spatial
            compositions, drawings, and studies made over the years.
          </p>
          <p class="ag-hint" id="ag-hint">drag to explore · drag a piece to re-hang it</p>
        </div>
        {
          withCover.map((p, i) => (
            <button
              class="ag-card reveal"
              style={`--d:${(i % 5) * 60}ms; --sx:${p.sx}px; --sy:${p.sy}px; --sc:${p.sc}; --sr:${p.sr}deg`}
              data-i={i}
              data-slug={p.slug}
              data-cursor="open"
              data-cursor-keep
              aria-label={`Open ${p.title}`}
            >
              {p.thumb ? (
                <img
                  class="ag-img"
                  src={p.thumb}
                  alt={p.title}
                  draggable={false}
                  loading="lazy"
                  decoding="async"
                  width={p.coverSize?.w || undefined}
                  height={p.coverSize?.h || undefined}
                />
              ) : (
                <span class="ag-ph">▶</span>
              )}
              <span class="ag-cap"><span class="ag-cap-t">{p.title}</span></span>
            </button>
          ))
        }
      </section>
      <button class="ag-reset" id="ag-reset" type="button" hidden title="Put every piece back where it started">reset layout</button>
    </div>
    <!-- shared WebGL layer for the ripple hover: ONE canvas for the whole board
         (25 canvases would be unusable), rendering only while hovering -->
    <canvas class="ag-gl" id="ag-gl" aria-hidden="true"></canvas>
  </main>

  <!-- expanded project view. data-lenis-prevent: the page's smooth-scroll
       (Lenis) intercepts wheel events globally — without this the fixed
       overlay can never scroll natively. -->
  <div class="pv" id="pv" aria-hidden="true" data-lenis-prevent>
    <button class="pv-close" id="pv-close" aria-label="Close and return to the gallery">
      <span class="pv-close-x">✕</span><span class="pv-close-t">Close</span>
    </button>
    <article class="pv-inner">
      <header class="pv-head">
        <p class="pv-meta" id="pv-meta"></p>
        <h2 class="pv-title" id="pv-title"></h2>
        <p class="pv-desc" id="pv-desc"></p>
      </header>
      <div class="pv-media" id="pv-media"></div>
      <nav class="pv-walk" aria-label="Works">
        <button class="pv-walk-b" id="pv-prev" type="button">
          <span class="pv-walk-k">← Prev</span><span class="pv-walk-t" id="pv-prev-t"></span>
        </button>
        <button class="pv-walk-b pv-walk-b--next" id="pv-next" type="button">
          <span class="pv-walk-k">Next →</span><span class="pv-walk-t" id="pv-next-t"></span>
        </button>
      </nav>
    </article>
    <!-- click-to-zoom, same affordance as the case-study images on /work -->
    <div class="pv-zoom" id="pv-zoom" aria-hidden="true">
      <button class="pv-close pv-zoom-x" id="pv-zoom-close" aria-label="Close zoom">✕</button>
      <img id="pv-zoom-img" alt="" />
    </div>
  </div>

  <script type="application/json" id="art-data" set:html={JSON.stringify(sized)}></script>
</BaseLayout>

<style>
  .art {
    --paper: #0c0c10; --ink: #ececf1; --muted: #8b8b96; --line: rgba(255, 255, 255, 0.1);
    background: var(--paper); color: var(--ink); min-height: 100vh;
    /* header + stage fill the viewport exactly — bottom padding would force a
       phantom page scroll behind the board */
    padding: 0 clamp(18px, 5vw, 64px);
    overflow: hidden;
  }
  :global([data-mode="light"]) .art { --paper: #f5f5f0; --ink: #1b1b20; --muted: #6a6a72; --line: rgba(0, 0, 0, 0.1); }

  .art-top {
    display: flex; justify-content: space-between; align-items: center;
    padding: 22px 0; font-family: "Geist Mono", monospace; font-size: 12px; letter-spacing: 0.06em;
    border-bottom: 1px solid var(--line);
    position: sticky; top: 0; z-index: 6;
    background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: saturate(1.2) blur(8px);
  }
  .art-back { color: var(--ink); text-decoration: none; }
  .art-back:hover { color: var(--muted); }
  .art-top-r { display: flex; align-items: center; gap: 16px; }
  .art-yr { color: var(--muted); text-transform: uppercase; }
  .art-mode { background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; width: 32px; height: 32px; display: grid; place-items: center; cursor: pointer; transition: border-color .2s, color .2s; }
  .art-mode:hover { color: var(--muted); }
  .art-mode .i-moon { display: none; }
  :global([data-mode="light"]) .art-mode .i-sun { display: none; }
  :global([data-mode="light"]) .art-mode .i-moon { display: block; }

  /* ── the sandbox board ─────────────────────────────────────────────────
     The stage fills the viewport under the header; the board inside is larger
     and pans with inertia. The board wears the site blueprint grid, so it
     reads as the drafting table the rest of the site draws on. */
  /* the page IS the board: html/body never scroll here (the reader overlay
     scrolls itself); the stage is sized to the real header in JS */
  :global(html:has(.art)), :global(html:has(.art) body) { overflow: hidden; height: 100%; overscroll-behavior: none; }
  .ag-stage { position: relative; overflow: hidden; height: calc(100dvh - 77px); margin: 0 calc(-1 * clamp(18px, 5vw, 64px)); cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; outline: none; }
  .ag-stage.dragging { cursor: grabbing; }
  .ag-stage:focus-visible { box-shadow: inset 0 0 0 2px var(--ink); }
  .ag-grid { position: relative; will-change: transform; background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 48px 48px; }

  /* centre block: the page title lives ON the board */
  .ag-center { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -52%); text-align: center; max-width: 560px; pointer-events: none; z-index: 1; }
  .art-title { font-family: "Mona Sans", sans-serif; font-weight: 700; font-size: clamp(64px, 9vw, 128px); line-height: 0.92; letter-spacing: -0.03em; margin: 0 0 18px; }
  .art-lede { font-size: clamp(14px, 1.6vw, 17px); line-height: 1.6; color: var(--muted); margin: 0 auto; max-width: 44ch; }
  .ag-hint { margin: 20px 0 0; font-family: "Geist Mono", monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); opacity: .85; transition: opacity .6s ease; }
  .ag-hint.off { opacity: 0; }

  /* pieces: pinned prints, draggable */
  /* The board's spacing is computed at build for 330px cards. At 20vw a phone
     clamped them to 170px — half-size pieces on a board built for full-size
     ones, which is why the wall looked empty on a phone. 62vw keeps them close
     to the size the layout assumes, and art wants to be big on a phone anyway. */
  .ag-card { position: absolute; left: var(--sx); top: var(--sy); width: clamp(240px, 30vw, 330px); margin: 0; padding: 0; border: 0; border-radius: 5px; overflow: hidden; cursor: pointer; color: inherit; background: transparent; box-shadow: 0 10px 26px -12px rgba(0,0,0,.55); transform: scale(var(--sc)) rotate(var(--sr)); transition: transform .45s cubic-bezier(.2,.7,.2,1), box-shadow .45s ease; }
  .ag-card.lifted { transition: none; cursor: grabbing; z-index: 5; box-shadow: 0 34px 70px -20px rgba(0,0,0,.8); }
  @media (hover: hover) {
    .ag-card:hover { transform: scale(calc(var(--sc) * 1.07)) rotate(0deg); box-shadow: 0 28px 56px -18px rgba(0,0,0,.72); z-index: 3; }
  }
  .ag-img { display: block; width: 100%; height: auto; -webkit-user-drag: none; user-drag: none; transition: opacity .18s ease, filter .5s ease; filter: saturate(.72) brightness(.84); }
  .ag-card.gl-active .ag-img { opacity: 0; }
  @media (hover: hover) { .ag-card:hover .ag-img { filter: saturate(1) brightness(1); } .ag-card:hover .ag-cap { opacity: 1; } }
  @media (hover: none) { .ag-cap { opacity: 1; } .ag-img { filter: none; } }
  .ag-ph { display: grid; place-items: center; aspect-ratio: 4 / 3; font-size: 34px; color: var(--muted); }
  .ag-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 14px 13px; background: linear-gradient(to top, rgba(0, 0, 0, 0.62), transparent); opacity: 0; transition: opacity 0.4s ease; pointer-events: none; text-align: left; z-index: 4; }
  .ag-cap-t { font-family: "Mona Sans", sans-serif; font-weight: 600; font-size: 14px; color: #fff; letter-spacing: -0.01em; }

  /* the ripple layer + controls */
  .ag-gl { position: fixed; inset: 0; z-index: 3; pointer-events: none; display: block; }
  .ag-reset { position: absolute; z-index: 6; right: 14px; bottom: 14px; font-family: "Geist Mono", monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; padding: 8px 13px; border-radius: 999px; border: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 80%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: var(--muted); cursor: pointer; }
  .ag-reset:hover { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 700px) {
    .ag-stage { height: calc(100dvh - 62px); }
    /* was clamp(150px, 44vw, 240px) → 172px on a 390px phone. The board's
       spacing is built for 330px pieces, so half-size cards made the wall look
       empty on a phone. Art also just wants to be big on a small screen. */
    .ag-card { width: clamp(240px, 62vw, 300px); }
    .art-title { font-size: clamp(44px, 15vw, 72px); }
    .ag-center { max-width: 320px; }
    .art-lede { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ag-card, .ag-img, .ag-hint { transition: none; }
    .ag-card:hover { transform: scale(var(--sc)); }
  }

  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease var(--d,0ms), transform .7s cubic-bezier(.2,.7,.2,1) var(--d,0ms); }
  .reveal.is-in { opacity: 1; transform: none; }
  /* board children carry their OWN transforms (title centering, card
     scale/tilt) — the reveal must animate opacity only, never zero those out.
     These outrank both .reveal states. */
  .ag-grid .ag-center.reveal, .ag-grid .ag-center.reveal.is-in { transform: translate(-50%, -52%); }
  .ag-grid .ag-card.reveal, .ag-grid .ag-card.reveal.is-in { transform: scale(var(--sc)) rotate(var(--sr)); }
  @media (hover: hover) {
    .ag-grid .ag-card.reveal:hover { transform: scale(calc(var(--sc) * 1.07)) rotate(0deg); }
  }
  .ag-grid .ag-card.reveal.lifted { transform: scale(calc(var(--sc) * 1.05)) rotate(0deg); }

  /* expanded project view */
  /* .pv is a SIBLING of <main class="art">, so --ink/--paper defined on .art do
     not reach it — it carries its own pair. */
  .pv { position: fixed; inset: 0; z-index: 100; display: none; overflow-y: auto; --pv-paper: #0a0a0d; --pv-ink: #ececf1; background: var(--pv-paper); color: var(--pv-ink); }
  :global([data-mode="light"]) .pv { --pv-paper: #f5f5f0; --pv-ink: #1b1b20; }
  .pv.open { display: block; }
  .pv-inner { max-width: 980px; margin: 0 auto; padding: clamp(64px, 12vh, 120px) clamp(20px, 5vw, 40px) 100px; }
  /* head: a quiet mono index, the title, then a hairline before the plates —
     the reader knows where it stands before it starts scrolling */
  .pv-head { border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent); margin-bottom: clamp(30px, 5vh, 52px); padding-bottom: clamp(22px, 3.5vh, 34px); }
  .pv-meta { font-family: "Geist Mono", monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: color-mix(in srgb, currentColor 42%, transparent); margin: 0 0 14px; }
  .pv-title { font-family: "Mona Sans", sans-serif; font-weight: 700; font-size: clamp(30px, 5vw, 52px); letter-spacing: -0.02em; line-height: 1.02; margin: 0 0 20px; }
  /* Measure was 62ch, which left the text stopping ~250px short of the title and
     plates above/below it — it read as misaligned rather than as a column. 76ch
     still keeps lines readable but sits flush enough with the rest of the page. */
  .pv-desc { font-size: clamp(15px, 1.8vw, 17px); line-height: 1.7; color: color-mix(in srgb, currentColor 62%, transparent); white-space: pre-line; margin: 0; max-width: 76ch; }
  /* plates: wide work runs full width, uprights pair two-up (aspect measured at
     build) so a long set reads as a hung wall, not a scroll dump */
  /* NOTE: everything inside .pv-media is injected at runtime (innerHTML), so it
     never carries Astro's scope attribute — these children MUST be :global() or
     the rules silently don't apply (the plate styling was dead before this). */
  .pv-media { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(14px, 2.4vw, 26px); align-items: start; }
  .pv-media :global(.pv-fig) { margin: 0; }
  .pv-media :global(.pv-fig--wide) { grid-column: 1 / -1; }
  .pv-media :global(img), .pv-media :global(.pv-embed) { width: 100%; border-radius: 6px; display: block; }
  .pv-media :global(img) { height: auto; box-shadow: 0 10px 40px rgba(0,0,0,.22); }
  @media (max-width: 680px) { .pv-media { grid-template-columns: 1fr; } .pv-media :global(.pv-fig) { grid-column: 1 / -1; } }
  /* walk: step to the next work without going back to the grid (mirrors the
     prev/next on the work pages, so the site speaks one language) */
  .pv-walk { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 2vw, 20px); margin-top: clamp(48px, 8vh, 84px); padding-top: clamp(22px, 3.5vh, 32px); border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent); }
  .pv-walk-b { display: flex; flex-direction: column; gap: 7px; align-items: flex-start; text-align: left; padding: 16px 18px; border-radius: 12px; border: 1px solid color-mix(in srgb, currentColor 12%, transparent); background: transparent; color: inherit; cursor: pointer; transition: border-color .22s ease, background-color .22s ease, transform .22s ease; }
  .pv-walk-b--next { align-items: flex-end; text-align: right; }
  .pv-walk-b:hover { border-color: color-mix(in srgb, currentColor 30%, transparent); background: color-mix(in srgb, currentColor 5%, transparent); transform: translateY(-1px); }
  .pv-walk-k { font-family: "Geist Mono", monospace; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: color-mix(in srgb, currentColor 42%, transparent); }
  .pv-walk-t { font-family: "Mona Sans", sans-serif; font-weight: 600; font-size: clamp(15px, 2vw, 19px); letter-spacing: -0.01em; }
  @media (prefers-reduced-motion: reduce) { .pv-walk-b { transition: none; } .pv-walk-b:hover { transform: none; } }
  /* injected at runtime too → :global (see note above) */
  .pv-media :global(.pv-embed) { aspect-ratio: 16 / 9; border: 0; }
  .pv-media :global(.pv-embed--tall) { aspect-ratio: 4 / 3; min-height: min(70vh, 640px); }  /* interactive 3D scenes get room */
  .pv-media :global(video.pv-embed) { aspect-ratio: auto; background: #000; max-height: 82vh; }
  .pv-media :global(.pv-pending) { grid-column: 1 / -1; font-family: "Geist Mono", monospace; font-size: 12px; color: color-mix(in srgb, currentColor 50%, transparent); border: 1px dashed color-mix(in srgb, currentColor 25%, transparent); border-radius: 8px; padding: 26px; text-align: center; }
  /* A faint grey circle vanished against bright artwork and got missed. This is
     a solid, labelled pill in the reader's inverted colours, so it reads on any
     plate underneath it, in either theme. */
  .pv-close { position: fixed; top: 18px; right: 20px; z-index: 101; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 16px 0 14px; border-radius: 999px; background: var(--pv-ink); color: var(--pv-paper); border: 1px solid var(--pv-ink); font-family: "Geist Mono", monospace; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; box-shadow: 0 8px 24px -10px rgba(0,0,0,.6); transition: transform .2s ease, opacity .2s ease; }
  .pv-close-x { font-size: 15px; line-height: 1; }
  .pv-close:hover { transform: translateY(-1px); }
  .pv-close:focus-visible { outline: 2px solid var(--pv-ink); outline-offset: 3px; }
  @media (max-width: 560px) { .pv-close-t { display: none; } .pv-close { padding: 0; width: 44px; justify-content: center; } }
  @media (prefers-reduced-motion: reduce) { .pv-close { transition: none; } .pv-close:hover { transform: none; } }
  /* zoom layer — sits above the reader, below the custom cursor (z 102) */
  .pv-zoom { position: fixed; inset: 0; z-index: 101; display: none; place-items: center; padding: clamp(.75rem, 2vw, 1.5rem); background: rgba(0,0,0,.92); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .pv-zoom.open { display: grid; }
  .pv-zoom img { max-width: 97vw; max-height: 94vh; width: auto; height: auto; border-radius: 8px; box-shadow: 0 40px 90px -24px rgba(0,0,0,.85); }
  /* the zoom layer is near-black, so its close pill inverts the other way */
  .pv-zoom-x { background: #fff; color: #111; border-color: #fff; width: 44px; padding: 0; justify-content: center; z-index: 102; }
  .pv-media :global(img[data-zoom]) { cursor: zoom-in; }
</style>

<script is:inline>
  (() => {
    const data = JSON.parse(document.getElementById("art-data").textContent);
    const pv = document.getElementById("pv");
    const tEl = document.getElementById("pv-title");
    const dEl = document.getElementById("pv-desc");
    const mEl = document.getElementById("pv-media");
    const mtEl = document.getElementById("pv-meta");
    const prevB = document.getElementById("pv-prev"), nextB = document.getElementById("pv-next");
    const prevT = document.getElementById("pv-prev-t"), nextT = document.getElementById("pv-next-t");
    let cur = 0;
    // only what the data actually knows — no invented years or mediums
    const kindOf = (p) => {
      const n = (p.plates || []).length;
      if (p.spline) return "Interactive 3D";
      if (p.video || (p.youtube || []).length) return (p.youtube || []).length > 1 ? `${p.youtube.length} videos` : "Video";
      return n ? `${n} ${n > 1 ? "plates" : "plate"}` : "";
    };
    const open = (i, push) => {
      const p = data[i];
      cur = i;
      const kind = kindOf(p);
      mtEl.textContent = `${String(i + 1).padStart(2, "0")} / ${String(data.length).padStart(2, "0")}${kind ? "  ·  " + kind : ""}`;
      tEl.textContent = p.title;
      dEl.textContent = p.desc || "";
      dEl.style.display = p.desc ? "" : "none";
      let html = "";
      if (p.video) html += `<figure class="pv-fig pv-fig--wide"><video class="pv-embed" controls playsinline preload="metadata"${p.cover ? ` poster="${p.cover}"` : ""}><source src="${p.video}" type="video/mp4"></video></figure>`;
      (p.youtube || []).forEach((id) => (html += `<figure class="pv-fig pv-fig--wide"><iframe class="pv-embed" src="https://www.youtube.com/embed/${id}" title="${p.title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe></figure>`));
      if (p.spline) html += `<figure class="pv-fig pv-fig--wide"><iframe class="pv-embed pv-embed--tall" src="${p.spline}" title="${p.title} — interactive 3D" loading="lazy" allow="fullscreen"></iframe></figure>`;
      // Rhythm: wide plates run full width; uprights pair two-up ONLY when they
      // actually have a partner. An upright with nothing beside it used to sit
      // in a half-width column with dead space next to it — which is why a
      // single-image work like Seoul Street looked small and stranded left.
      const plates = p.plates || [];
      const spanFull = plates.map((im, n) => {
        if (im.wide) return true;
        const prevUpright = n > 0 && !plates[n - 1].wide;
        const nextUpright = n + 1 < plates.length && !plates[n + 1].wide;
        // paired if it starts a pair (next is upright and this one didn't close
        // a previous pair) or closes one
        let pairIndex = 0;
        for (let k = 0; k <= n; k++) pairIndex = plates[k].wide ? 0 : pairIndex + 1;
        const opensPair = pairIndex % 2 === 1;
        return opensPair ? !nextUpright : !prevUpright;   // unpaired → full width
      });
      plates.forEach((im, n) => {
        const dim = im.w && im.h ? ` width="${im.w}" height="${im.h}"` : "";
        html += `<figure class="pv-fig${spanFull[n] ? " pv-fig--wide" : ""}"><img src="${im.src}" alt="${p.title}" loading="lazy" decoding="async" data-zoom${dim}></figure>`;
      });
      if (p.videoPending && !(p.plates || []).length && !(p.youtube || []).length && !p.video) html += `<div class="pv-pending">▶ Video piece — embed coming soon.</div>`;
      mEl.innerHTML = html;
      const pi = (i - 1 + data.length) % data.length, ni = (i + 1) % data.length;
      prevT.textContent = data[pi].title;
      nextT.textContent = data[ni].title;
      pv.classList.add("open");
      pv.setAttribute("aria-hidden", "false");
      pv.scrollTop = 0;
      document.body.style.overflow = "hidden";
      // the custom cursor ring sits at z-index 39 (under the header); this
      // overlay is z-index 100, so without lifting it the ring is buried and —
      // because cursor-on sets `cursor: none` — the reader has NO cursor at all
      document.documentElement.classList.add("pv-open");
      // Opening from the grid pushes one entry so browser Back closes the view.
      // Walking with ← → REPLACES it, so browsing ten works doesn't bury the
      // gallery ten entries deep in history.
      if (push === "replace") history.replaceState({ pv: i }, "", "#" + (p.slug || i));
      else if (push !== false) history.pushState({ pv: i }, "", "#" + (p.slug || i));
    };
    const step = (d) => open((cur + d + data.length) % data.length, "replace");
    prevB.addEventListener("click", () => step(-1));
    nextB.addEventListener("click", () => step(1));
    const doClose = () => { pv.classList.remove("open"); pv.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; document.documentElement.classList.remove("pv-open"); closeZoom(); mEl.innerHTML = ""; };
    // ✕ means "back to the gallery" — it closes and drops the #slug, rather than
    // stepping back through history into whichever work was viewed before.
    const close = () => { doClose(); history.replaceState(null, "", location.pathname); };
    addEventListener("popstate", (e) => {
      if (e.state && e.state.pv != null) open(e.state.pv, false);
      else if (pv.classList.contains("open")) doClose();
    });
    document.querySelectorAll(".ag-card").forEach((b) => b.addEventListener("click", () => open(+b.dataset.i)));
    document.getElementById("pv-close").addEventListener("click", close);
    // click any plate to see it full-screen (same affordance as /work images)
    const zoom = document.getElementById("pv-zoom");
    const zoomImg = document.getElementById("pv-zoom-img");
    const openZoom = (src, alt) => { zoomImg.src = src; zoomImg.alt = alt || ""; zoom.classList.add("open"); zoom.setAttribute("aria-hidden", "false"); };
    const closeZoom = () => { zoom.classList.remove("open"); zoom.setAttribute("aria-hidden", "true"); zoomImg.removeAttribute("src"); };
    mEl.addEventListener("click", (e) => {
      const img = e.target.closest("img[data-zoom]");
      if (img) openZoom(img.currentSrc || img.src, img.alt);
    });
    zoom.addEventListener("click", closeZoom);
    addEventListener("keydown", (e) => {
      if (!pv.classList.contains("open")) return;
      // the zoom is on top, so Escape dismisses it first
      if (zoom.classList.contains("open")) { if (e.key === "Escape") closeZoom(); return; }
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);           // walk the room with ← →
      else if (e.key === "ArrowRight") step(1);
    });
    // ─── THE SANDBOX ──────────────────────────────────────────────────────
    // One interaction system, three gestures, one render loop:
    //   drag the board   → pan with inertia (target-velocity easing, the
    //                      Codrops infinite-canvas input model)
    //   drag a piece     → re-hang it; the position persists per-slug
    //   click/tap        → open the reader (a drag past 8px never clicks)
    // Perf: ONE rAF integrator paints the board; the ripple shader reads NO
    // layout in its loop — card rects are cached in board space and offset by
    // the current pan, so pointermove storms never force reflow.
    (() => {
      const stage = document.getElementById("ag-stage");
      const grid = document.getElementById("ag-grid");
      const canvas = document.getElementById("ag-gl");
      const hintEl = document.getElementById("ag-hint");
      const resetBtn = document.getElementById("ag-reset");
      if (!stage || !grid || !canvas) return;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
      const POS_KEY = "art-sandbox-pos-v1";

      // ── restore re-hung pieces ──
      let savedPos = {};
      try { savedPos = JSON.parse(localStorage.getItem(POS_KEY) || "{}"); } catch {}
      const cards = [...grid.querySelectorAll(".ag-card")];
      const boardW = grid.offsetWidth, boardH = grid.offsetHeight;
      // Remember where the build hung each piece BEFORE any saved position is
      // applied. The scattered layout lives only in the inline --sx/--sy, so
      // "reset" cannot just delete them — that leaves left/top resolving to 0
      // and stacks every piece in the top-left corner, which reads as the art
      // having vanished.
      const home = new Map(cards.map((c) => [c, {
        x: c.style.getPropertyValue("--sx"), y: c.style.getPropertyValue("--sy"),
      }]));
      for (const c of cards) {
        const p = savedPos[c.dataset.slug];
        if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) {
          c.style.setProperty("--sx", Math.max(0, Math.min(boardW - 180, p.x)) + "px");
          c.style.setProperty("--sy", Math.max(0, Math.min(boardH - 140, p.y)) + "px");
        }
      }
      const savePos = () => { try { localStorage.setItem(POS_KEY, JSON.stringify(savedPos)); } catch {} };
      resetBtn.hidden = Object.keys(savedPos).length === 0;
      resetBtn.addEventListener("click", () => {
        savedPos = {}; savePos();
        for (const c of cards) {
          const h = home.get(c);
          if (h) { c.style.setProperty("--sx", h.x); c.style.setProperty("--sy", h.y); }
        }
        resetBtn.hidden = true;
        cacheRects();
      });

      // ── board-space rect cache (kills per-frame getBoundingClientRect) ──
      // rects are stored relative to the BOARD; viewport rect = stageOrigin +
      // boardRect + pan. Recomputed only on resize, drop, or reset.
      let stageRect = stage.getBoundingClientRect();
      const rectOf = new Map();
      const cacheRects = () => {
        stageRect = stage.getBoundingClientRect();
        for (const c of cards) {
          const x = parseFloat(getComputedStyle(c).left) || 0;
          const y = parseFloat(getComputedStyle(c).top) || 0;
          // width is styled; height follows the image aspect
          rectOf.set(c, { x, y, w: c.offsetWidth, h: c.offsetHeight, s: parseFloat(c.style.getPropertyValue("--sc")) || 1 });
        }
      };

      // ── pan state: input writes a target, ONE integrator eases toward it ──
      let px = 0, py = 0;             // painted pan
      let vx = 0, vy = 0;             // inertia velocity
      let panning = false, lifted = null, downCard = null, captured = false, activePointer = 0;
      let downX = 0, downY = 0, lastX = 0, lastY = 0, moved = 0;
      let liftDX = 0, liftDY = 0;
      let ticking = false;
      const maxX = () => Math.min(0, stage.clientWidth - boardW);
      const maxY = () => Math.min(0, stage.clientHeight - boardH);
      const clampPan = () => { px = Math.max(maxX(), Math.min(0, px)); py = Math.max(maxY(), Math.min(0, py)); };
      const paint = () => { grid.style.transform = `translate3d(${px}px, ${py}px, 0)`; };
      const tick = () => {
        if (!panning && !reduce && (Math.abs(vx) > 0.12 || Math.abs(vy) > 0.12)) {
          px += vx; py += vy; vx *= 0.93; vy *= 0.93;
          clampPan(); paint();
          if (card && !raf) raf = requestAnimationFrame(draw);
          requestAnimationFrame(tick);
        } else { ticking = false; }
      };
      const glideOn = () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } };
      const dismissHint = () => { if (hintEl && !hintEl.classList.contains("off")) hintEl.classList.add("off"); };

      // Once ANY text is selected on the page, the browser treats a subsequent
      // press-and-move as dragging that selection: it fires a native dragstart
      // and hauls a ghost of the image around instead of re-hanging the piece.
      // That is why the board only misbehaved "after a few drags" — it needed a
      // stray selection first. Kill selections at the source, and refuse native
      // drags outright.
      stage.addEventListener("dragstart", (e) => e.preventDefault());
      stage.addEventListener("selectstart", (e) => e.preventDefault());

      stage.addEventListener("pointerdown", (e) => {
        if (e.button !== undefined && e.button !== 0) return;
        const sel = document.getSelection?.();
        if (sel && !sel.isCollapsed) sel.removeAllRanges();   // clear a stray selection before it hijacks the drag
        downCard = e.target.closest(".ag-card");
        panning = !downCard;
        lifted = null; moved = 0; vx = vy = 0; captured = false;
        downX = lastX = e.clientX; downY = lastY = e.clientY;
        activePointer = e.pointerId;
        if (panning) stage.classList.add("dragging");
      });
      stage.addEventListener("pointermove", (e) => {
        if (!panning && !downCard) return;
        const dx = e.clientX - lastX, dy = e.clientY - lastY;
        lastX = e.clientX; lastY = e.clientY;
        // capture LATE, only once this is genuinely a drag — capturing on
        // pointerdown retargets the eventual click to the stage, so clicking a
        // card could never open it
        if (!captured && moved + Math.abs(dx) + Math.abs(dy) > 8) {
          captured = true;
          try { stage.setPointerCapture?.(activePointer); } catch {}
        }
        moved += Math.abs(dx) + Math.abs(dy);
        if (downCard) {
          // a real drag on a piece = re-hang it
          if (!lifted && moved > 8) {
            lifted = downCard;
            lifted.classList.add("lifted");
            const r = rectOf.get(lifted) || { x: 0, y: 0 };
            liftDX = (e.clientX - stageRect.left - px) - r.x;
            liftDY = (e.clientY - stageRect.top - py) - r.y;
            stopGL();
          }
          if (lifted) {
            const nx = Math.max(0, Math.min(boardW - 150, e.clientX - stageRect.left - px - liftDX));
            const ny = Math.max(0, Math.min(boardH - 120, e.clientY - stageRect.top - py - liftDY));
            lifted.style.setProperty("--sx", nx + "px");
            lifted.style.setProperty("--sy", ny + "px");
          }
          return;
        }
        // board pan
        px += dx; py += dy; vx = dx; vy = dy;
        clampPan(); paint();
        dismissHint();
        if (card && !raf) raf = requestAnimationFrame(draw);
      });
      const release = (e) => {
        if (lifted) {
          const x = parseFloat(lifted.style.getPropertyValue("--sx"));
          const y = parseFloat(lifted.style.getPropertyValue("--sy"));
          savedPos[lifted.dataset.slug] = { x, y };
          savePos();
          resetBtn.hidden = false;
          lifted.classList.remove("lifted");
          lifted = null;
          dismissHint();
          cacheRects();
        } else if (panning && !reduce) glideOn();
        panning = false; downCard = null;
        stage.classList.remove("dragging");
      };
      stage.addEventListener("pointerup", release);
      stage.addEventListener("pointercancel", release);
      // a drag must never fire the card's click
      stage.addEventListener("click", (e) => { if (moved > 8) { e.stopPropagation(); e.preventDefault(); } }, true);

      // Tab-focusing a clipped card makes the browser scroll this overflow:hidden
      // container internally, which would desync the transform pan — fold any
      // native scroll straight back into the pan and zero it.
      stage.addEventListener("scroll", () => {
        if (!stage.scrollLeft && !stage.scrollTop) return;
        px -= stage.scrollLeft; py -= stage.scrollTop;
        stage.scrollLeft = 0; stage.scrollTop = 0;
        clampPan(); paint();
      }, { passive: true });

      // wheel / trackpad pans the board (stage carries data-lenis-prevent)
      stage.addEventListener("wheel", (e) => {
        e.preventDefault();
        px -= e.deltaX; py -= e.deltaY;
        vx = vy = 0;
        clampPan(); paint(); dismissHint();
        if (card && !raf) raf = requestAnimationFrame(draw);
      }, { passive: false });

      // keyboard pan for the stage itself; cards stay buttons (Tab + Enter)
      stage.addEventListener("keydown", (e) => {
        const STEP = 140;
        const k = e.key;
        if (k === "ArrowLeft") px += STEP; else if (k === "ArrowRight") px -= STEP;
        else if (k === "ArrowUp") py += STEP; else if (k === "ArrowDown") py -= STEP;
        else return;
        e.preventDefault();
        clampPan(); paint(); dismissHint();
      });

      // start centred on the title block
      const center = () => {
        // Desktop lands on the title. A phone viewport fits INSIDE the title
        // hole, which meant landing on a void — shift the focus down so the
        // title peeks at the top and the row of art below it fills the screen.
        const shiftY = stage.clientWidth < 700 ? 320 : 0;
        px = stage.clientWidth / 2 - boardW / 2;
        py = stage.clientHeight / 2 - (boardH / 2 + shiftY);
        clampPan(); paint();
      };
      center();
      addEventListener("resize", () => { cacheRects(); clampPan(); paint(); }, { passive: true });

      // ── the ripple hover: one canvas, texture per hovered card ──
      let gl = null, prog = null, tex = null, raf = 0, card = null;
      let mx = 0.5, my = 0.5, t0 = 0, enter = 0, gen = 0;
      const uni = {};
      const initGL = () => {
        if (gl) return !!prog;
        gl = canvas.getContext("webgl", { alpha: true, antialias: true, premultipliedAlpha: false });
        if (!gl) return false;
        // p.y = 0 is the TOP of the card and texImage2D puts the image's first
        // row at t = 0, so UV is p directly.
        const vs = `attribute vec2 p; uniform vec4 uRect; uniform vec2 uRes; varying vec2 vUv;
          void main(){ vUv = p; vec2 px = uRect.xy + p * uRect.zw;
          vec2 cl = (px / uRes) * 2.0 - 1.0; gl_Position = vec4(cl.x, -cl.y, 0.0, 1.0); }`;
        const fs = `precision highp float; uniform sampler2D uTex; uniform vec2 uMouse;
          uniform float uT; uniform float uEnter; varying vec2 vUv;
          void main(){
            vec2 uv = vUv; vec2 d = uv - uMouse; float r = length(d);
            float w = sin(r * 22.0 - uT * 3.2) * exp(-r * 4.5) * 0.038 * uEnter;
            vec2 off = normalize(d + 1e-6) * w;
            float ca = 0.005 * uEnter * exp(-r * 3.0);
            vec3 c;
            c.r = texture2D(uTex, uv + off + vec2(ca, 0.0)).r;
            c.g = texture2D(uTex, uv + off).g;
            c.b = texture2D(uTex, uv + off - vec2(ca, 0.0)).b;
            float lift = 1.0 + 0.16 * uEnter * exp(-r * 3.5);
            gl_FragColor = vec4(c * lift, 1.0);
          }`;
        const sh = (type, src) => { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null; };
        const v = sh(gl.VERTEX_SHADER, vs), f = sh(gl.FRAGMENT_SHADER, fs);
        if (!v || !f) return false;
        prog = gl.createProgram(); gl.attachShader(prog, v); gl.attachShader(prog, f); gl.linkProgram(prog);
        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { prog = null; return false; }
        gl.useProgram(prog);
        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([0, 0, 1, 0, 0, 1, 0, 1, 1, 0, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, "p");
        gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        for (const n of ["uRect", "uRes", "uMouse", "uT", "uEnter"]) uni[n] = gl.getUniformLocation(prog, n);
        tex = gl.createTexture();
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        return true;
      };
      const sizeCanvas = () => {
        const dpr = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(innerWidth * dpr);
        canvas.height = Math.round(innerHeight * dpr);
        canvas.style.width = innerWidth + "px";
        canvas.style.height = innerHeight + "px";
        if (gl) gl.viewport(0, 0, canvas.width, canvas.height);
      };
      const draw = (now) => {
        if (!card || !prog) { raf = 0; return; }
        if (!t0) t0 = now;
        enter = Math.min(1, enter + 0.08);
        const r = rectOf.get(card);
        if (!r) { raf = 0; return; }
        // viewport rect from the CACHE + live pan — zero layout reads here.
        // scale() keeps the card's centre, so offset by the scale delta.
        const w = r.w * r.s, h = r.h * r.s;
        const left = stageRect.left + px + r.x - (w - r.w) / 2;
        const top = stageRect.top + py + r.y - (h - r.h) / 2;
        gl.useProgram(prog);
        gl.uniform4f(uni.uRect, left, top, w, h);
        gl.uniform2f(uni.uRes, innerWidth, innerHeight);
        gl.uniform2f(uni.uMouse, mx, my);
        gl.uniform1f(uni.uT, (now - t0) / 1000);
        gl.uniform1f(uni.uEnter, enter);
        gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.drawArrays(gl.TRIANGLES, 0, 6);
        raf = requestAnimationFrame(draw);
      };
      const stopGL = () => {
        gen++;
        grid.querySelectorAll(".ag-card.gl-active").forEach((c) => c.classList.remove("gl-active"));
        card = null; enter = 0; t0 = 0;
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        if (gl) { gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT); }
      };
      const startGL = (el) => {
        const src = el.querySelector(".ag-img")?.getAttribute("src");
        if (!src || !initGL()) return;
        const myGen = ++gen;
        const im = new Image();
        im.crossOrigin = "anonymous";
        im.onload = () => {
          if (myGen !== gen) return;
          try {
            gl.bindTexture(gl.TEXTURE_2D, tex);
            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, im);
          } catch { return; }
          card = el; enter = 0; t0 = 0;
          el.classList.add("gl-active");
          sizeCanvas();
          if (!raf) raf = requestAnimationFrame(draw);
        };
        im.onerror = () => {};
        im.src = src;
      };
      if (fine && !reduce) {
        stage.addEventListener("pointerover", (e) => {
          if (lifted || panning) return;
          const el = e.target.closest(".ag-card");
          if (el && el !== card) { stopGL(); startGL(el); }
          else if (!el && card) stopGL();
        });
        stage.addEventListener("pointermove", (e) => {
          if (!card) return;
          const r = rectOf.get(card);
          if (!r) return;
          const w = r.w * r.s, h = r.h * r.s;
          const left = stageRect.left + px + r.x - (w - r.w) / 2;
          const top = stageRect.top + py + r.y - (h - r.h) / 2;
          mx = (e.clientX - left) / w; my = (e.clientY - top) / h;
        });
        stage.addEventListener("pointerleave", stopGL);
        addEventListener("resize", () => { if (card) sizeCanvas(); }, { passive: true });
      }

      // rect cache once images have sized themselves (heights follow aspect)
      if (document.readyState === "complete") cacheRects();
      addEventListener("load", cacheRects);
      cacheRects();
    })();

    // deep link: /art#slug opens that project directly
    const initial = data.findIndex((p) => "#" + (p.slug || "") === decodeURIComponent(location.hash));
    if (initial >= 0) { history.replaceState(null, "", location.pathname); open(initial); }
  })();
</script>
